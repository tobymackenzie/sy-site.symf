{% block doctype %}<!DOCTYPE html>{% endblock %}
{% block docWrap %}
<html{% block docAttr %} class="{% block docClasses %}doc-{{ doc.name | default('default') }}{% if doc.classes is defined %} {{doc.classes | raw}}{% endif %}{% endblock %}"{% if doc.attr is defined %} {{doc.attr | raw}}{% endif %}{% endblock %}>
{%	block docHeadWrap %}
	<head>
{%		block docCharsetWrap %}
		<meta charset="{% block docCharset %}{{ doc.charset | default('utf-8') }}{% endblock %}" />
{%		endblock %}
{%		block docTitleWrap %}
		<title>{% block docTitle %}{% if doc.title is defined %}{{doc.title}} - {% endif %}{{ site.title | default('Site') }}{% endblock %}</title>
{%		endblock %}
{%		block docMeta %}
		{% if doc.description is defined %}<meta name="description" content="{{doc.description}}" />{% endif %}
		{% if doc.keywords is defined %}<meta name="keywords" content="{{doc.keywords}}" />{% endif %}
		{% if site.isResponsive is defined %}<meta name="viewport" content="initial-scale=1,width=device-width" />{% endif %}
{%		endblock %}
{%		block docStyles %}{% endblock %}
{%		block docPreScripts %}{% endblock %}
	</head>
{%	endblock %}
{%	block docBodyWrap %}
	<body>
{%		block docBody %}{% endblock %}
{%		block docPostScripts %}
{% if app.environment == 'dev' %}<s id="TJMDEV" hidden=""></s>{% endif %}
{%		endblock %}
	</body>
{%	endblock %}
</html>
{% endblock %}
